<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Public build inputs only; these also make the final AAB auditable. -->
        <meta-data android:name="findit.hidden.APP_ENV" android:value="${hiddenAppEnvironment}" />
        <meta-data android:name="findit.hidden.BUILD_STAGE" android:value="${hiddenBuildStage}" />
        <meta-data android:name="findit.hidden.PRIVACY_POLICY_URL" android:value="${hiddenPrivacyPolicyUrl}" />
        <meta-data android:name="findit.hidden.PACK_INDEX_URL" android:value="${hiddenPackIndexUrl}" />
    </application>
</manifest>
